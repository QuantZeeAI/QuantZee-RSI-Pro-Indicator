//@version=6
// ─────────────────────────────────────────────────────────────────────────────
//  RSI Pro+ | Divergence + Adaptive Bands + MTF [Quantzee]
//  An RSI toolkit: auto divergence engine (regular + hidden), adaptive
//  percentile-based OB/OS bands, and a multi-timeframe RSI dashboard.
//  Open-source. Original implementation — written from scratch.
// ─────────────────────────────────────────────────────────────────────────────
indicator("RSI Pro+ | Divergence + Adaptive Bands + MTF [Quantzee]", shorttitle = "RSI Pro+",
     overlay = false, max_lines_count = 500, max_labels_count = 500)

// ─────────────────────────── INPUTS ──────────────────────────────────────────
grpRSI = "RSI Core"
rsiLen = input.int(14, "RSI Length", minval = 2, group = grpRSI)
rsiSrc = input.source(close, "Source", group = grpRSI)

grpBND = "Adaptive OB / OS Bands"
useAdaptive = input.bool(true, "Adaptive Bands (percentile-based)", group = grpBND,
     tooltip = "When ON, overbought/oversold levels are computed as rolling percentiles of the RSI itself, so they adapt to the current market regime. When OFF, static 70/30-style levels are used.")
bandLen  = input.int(200, "Adaptive Lookback (bars)", minval = 50, group = grpBND)
obPct    = input.float(90, "Overbought Percentile", minval = 70, maxval = 99, step = 1, group = grpBND)
osPct    = input.float(10, "Oversold Percentile",  minval = 1,  maxval = 30, step = 1, group = grpBND)
obStatic = input.float(70, "Static Overbought", group = grpBND)
osStatic = input.float(30, "Static Oversold",  group = grpBND)

grpDIV = "Divergence Engine"
showReg = input.bool(true,  "Regular Divergences", group = grpDIV)
showHid = input.bool(false, "Hidden Divergences",  group = grpDIV)
lbL     = input.int(5, "Pivot Lookback Left",  minval = 1, group = grpDIV)
lbR     = input.int(5, "Pivot Lookback Right", minval = 1, group = grpDIV,
     tooltip = "A pivot (and therefore a divergence) is confirmed this many bars after it forms. Once printed, signals do not repaint.")
rngMin  = input.int(5,  "Min Bars Between Pivots", minval = 1, group = grpDIV)
rngMax  = input.int(60, "Max Bars Between Pivots", minval = 2, group = grpDIV)

grpTBL = "Multi-Timeframe Dashboard"
showTbl = input.bool(true, "Show MTF RSI Table", group = grpTBL)
tblPosS = input.string("Top Right", "Position",
     options = ["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group = grpTBL)
tfA = input.timeframe("5",   "Timeframe 1", group = grpTBL)
tfB = input.timeframe("15",  "Timeframe 2", group = grpTBL)
tfC = input.timeframe("60",  "Timeframe 3", group = grpTBL)
tfD = input.timeframe("240", "Timeframe 4", group = grpTBL)
tfE = input.timeframe("D",   "Timeframe 5", group = grpTBL)

// ─────────────────────────── CORE ─────────────────────────────────────────────
rsi = ta.rsi(rsiSrc, rsiLen)

obLevel = useAdaptive ? ta.percentile_linear_interpolation(rsi, bandLen, obPct) : obStatic
osLevel = useAdaptive ? ta.percentile_linear_interpolation(rsi, bandLen, osPct) : osStatic

colUp = #089981
colDn = #f23645

rsiColor = color.from_gradient(rsi, 30, 70, colDn, colUp)
pRSI = plot(rsi, "RSI", rsiColor, 2)
pOB  = plot(obLevel, "Overbought Level", color.new(colDn, 55))
pOS  = plot(osLevel, "Oversold Level",  color.new(colUp, 55))
hline(50, "Midline", color.new(color.gray, 50), hline.style_dotted)
fill(pOB, pOS, color = color.new(color.gray, 92), title = "Band Fill")
bgcolor(rsi > obLevel ? color.new(colDn, 88) : rsi < osLevel ? color.new(colUp, 88) : na,
     title = "OB/OS Background")

// ─────────────────────── DIVERGENCE ENGINE ───────────────────────────────────
plFound = not na(ta.pivotlow(rsi, lbL, lbR))
phFound = not na(ta.pivothigh(rsi, lbL, lbR))

// previous pivot values (occurrence 1 = the pivot before the current one)
prevRsiLow    = ta.valuewhen(plFound, rsi[lbR], 1)
prevPriceLow  = ta.valuewhen(plFound, low[lbR], 1)
prevPlBar     = ta.valuewhen(plFound, bar_index - lbR, 1)
prevRsiHigh   = ta.valuewhen(phFound, rsi[lbR], 1)
prevPriceHigh = ta.valuewhen(phFound, high[lbR], 1)
prevPhBar     = ta.valuewhen(phFound, bar_index - lbR, 1)

barsPl = ta.barssince(plFound[1])
barsPh = ta.barssince(phFound[1])
inRangePl = barsPl >= rngMin and barsPl <= rngMax
inRangePh = barsPh >= rngMin and barsPh <= rngMax

// Regular bullish: price makes a lower low, RSI makes a higher low
bullDiv  = showReg and plFound and inRangePl and low[lbR]  < prevPriceLow  and rsi[lbR] > prevRsiLow
// Hidden bullish: price makes a higher low, RSI makes a lower low
hBullDiv = showHid and plFound and inRangePl and low[lbR]  > prevPriceLow  and rsi[lbR] < prevRsiLow
// Regular bearish: price makes a higher high, RSI makes a lower high
bearDiv  = showReg and phFound and inRangePh and high[lbR] > prevPriceHigh and rsi[lbR] < prevRsiHigh
// Hidden bearish: price makes a lower high, RSI makes a higher high
hBearDiv = showHid and phFound and inRangePh and high[lbR] < prevPriceHigh and rsi[lbR] > prevRsiHigh

if bullDiv
    line.new(int(prevPlBar), prevRsiLow, bar_index - lbR, rsi[lbR],
         color = color.new(colUp, 0), width = 2)
    label.new(bar_index - lbR, rsi[lbR], "Bull",
         style = label.style_label_up, color = color.new(colUp, 0),
         textcolor = color.white, size = size.tiny)

if hBullDiv
    line.new(int(prevPlBar), prevRsiLow, bar_index - lbR, rsi[lbR],
         color = color.new(colUp, 30), width = 1, style = line.style_dashed)
    label.new(bar_index - lbR, rsi[lbR], "H Bull",
         style = label.style_label_up, color = color.new(colUp, 40),
         textcolor = color.white, size = size.tiny)

if bearDiv
    line.new(int(prevPhBar), prevRsiHigh, bar_index - lbR, rsi[lbR],
         color = color.new(colDn, 0), width = 2)
    label.new(bar_index - lbR, rsi[lbR], "Bear",
         style = label.style_label_down, color = color.new(colDn, 0),
         textcolor = color.white, size = size.tiny)

if hBearDiv
    line.new(int(prevPhBar), prevRsiHigh, bar_index - lbR, rsi[lbR],
         color = color.new(colDn, 30), width = 1, style = line.style_dashed)
    label.new(bar_index - lbR, rsi[lbR], "H Bear",
         style = label.style_label_down, color = color.new(colDn, 40),
         textcolor = color.white, size = size.tiny)

// ─────────────────── MULTI-TIMEFRAME DASHBOARD ───────────────────────────────
f_rsi(string tf) =>
    request.security(syminfo.tickerid, tf, ta.rsi(rsiSrc, rsiLen),
         lookahead = barmerge.lookahead_off)

rsiA = f_rsi(tfA)
rsiB = f_rsi(tfB)
rsiC = f_rsi(tfC)
rsiD = f_rsi(tfD)
rsiE = f_rsi(tfE)

tblPos = tblPosS == "Top Right" ? position.top_right :
     tblPosS == "Top Left" ? position.top_left :
     tblPosS == "Bottom Right" ? position.bottom_right : position.bottom_left

var table tbl = table.new(tblPos, 3, 6, border_width = 1,
     border_color = color.new(color.gray, 70))

f_row(int row, string tfTxt, float r) =>
    stat   = r >= 70 ? "OB" : r <= 30 ? "OS" : "–"
    statBg = r >= 70 ? color.new(colDn, 70) : r <= 30 ? color.new(colUp, 70) : color.new(color.gray, 85)
    table.cell(tbl, 0, row, tfTxt, text_color = color.white,
         bgcolor = color.new(color.gray, 80), text_size = size.tiny)
    table.cell(tbl, 1, row, na(r) ? "…" : str.tostring(r, "#.0"),
         text_color = color.white, bgcolor = color.new(color.gray, 85), text_size = size.tiny)
    table.cell(tbl, 2, row, stat, text_color = color.white,
         bgcolor = statBg, text_size = size.tiny)

if showTbl and barstate.islast
    table.cell(tbl, 0, 0, "TF",     text_color = color.white, bgcolor = color.new(color.blue, 60), text_size = size.tiny)
    table.cell(tbl, 1, 0, "RSI",    text_color = color.white, bgcolor = color.new(color.blue, 60), text_size = size.tiny)
    table.cell(tbl, 2, 0, "Status", text_color = color.white, bgcolor = color.new(color.blue, 60), text_size = size.tiny)
    f_row(1, tfA, rsiA)
    f_row(2, tfB, rsiB)
    f_row(3, tfC, rsiC)
    f_row(4, tfD, rsiD)
    f_row(5, tfE, rsiE)

// ─────────────────────────── ALERTS ───────────────────────────────────────────
alertcondition(bullDiv,  "Regular Bullish Divergence",  "RSI Pro+ {{ticker}} {{interval}}: Regular bullish divergence confirmed")
alertcondition(bearDiv,  "Regular Bearish Divergence",  "RSI Pro+ {{ticker}} {{interval}}: Regular bearish divergence confirmed")
alertcondition(hBullDiv, "Hidden Bullish Divergence",   "RSI Pro+ {{ticker}} {{interval}}: Hidden bullish divergence confirmed")
alertcondition(hBearDiv, "Hidden Bearish Divergence",   "RSI Pro+ {{ticker}} {{interval}}: Hidden bearish divergence confirmed")
alertcondition(ta.crossunder(rsi, obLevel), "RSI Exits Overbought", "RSI Pro+ {{ticker}} {{interval}}: RSI crossed back below the overbought band")
alertcondition(ta.crossover(rsi, osLevel),  "RSI Exits Oversold",   "RSI Pro+ {{ticker}} {{interval}}: RSI crossed back above the oversold band")
